# Dependencias — nunca subir, son miles de archivos
node_modules/
__pycache__/
*.pyc
backend/.venv/
.venv/
venv/

# Builds — se generan solos, no se suben
frontend/dist/
deploy/

# Registros generados en ejecución
backend/logs/
data/energy_logs.csv

# Fotos de referencia del salón real (331 MB) — sirven para modelar el
# gemelo digital, no para publicarse
fotos_enseñanza/

# Pesos de los modelos de IA. Los de COCO-SSD (65 MB) no van al repo: se bajan
# con  python3 backend/scripts/fetch_vision_models.py --all
# BlazeFace sí va, porque pesa 465 KB y Netlify solo publica lo que está en
# git: sin él, la cámara del sitio publicado daría 404.
backend/static/vendor/models/*
!backend/static/vendor/models/blazeface/

# macOS
.DS_Store

# LibreOffice
.~lock.*#

# Caché local de wrangler — trae el id y el correo de la cuenta
.wrangler/
